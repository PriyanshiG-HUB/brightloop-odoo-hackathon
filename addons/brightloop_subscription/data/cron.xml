<odoo>
    <record id="ir_cron_brightloop_recurring_billing" model="ir.cron">
        <field name="name">Brightloop: Generate recurring invoices</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>

