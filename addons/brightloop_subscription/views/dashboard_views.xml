<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_dashboard_form" model="ir.ui.view">
        <field name="name">subscription.dashboard.form</field>
        <field name="model">subscription.dashboard</field>
        <field name="arch" type="xml">
            <form string="Brightloop Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Dashboard"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group name="financial_metrics" string="Recurring Revenue (ARR / MRR)" col="2">
                        <group>
                            <field name="monthly_recurring_revenue" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group>
                            <field name="annual_recurring_revenue" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>

                    <group name="subscription_status" string="Subscription Operations" col="3">
                        <group>
                            <field name="active_subscriptions"/>
                            <field name="total_subscriptions"/>
                        </group>
                        <group>
                            <field name="paused_subscriptions"/>
                            <field name="closed_subscriptions"/>
                        </group>
                        <group>
                            <field name="cancelled_subscriptions"/>
                            <field name="total_customers"/>
                        </group>
                    </group>

                    <group name="cash_flow_metrics" string="Billing &amp; Receivables" col="2">
                        <group>
                            <field name="revenue_received" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="outstanding_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group>
                            <field name="overdue_invoice_count"/>
                            <field name="failed_billing_period_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="subscription_dashboard_main" model="subscription.dashboard">
        <field name="name">Brightloop Overview</field>
    </record>

    <record id="action_subscription_dashboard" model="ir.actions.act_window">
        <field name="name">Brightloop Dashboard</field>
        <field name="res_model">subscription.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="subscription_dashboard_main"/>
    </record>
</odoo>
