<odoo>
    <!-- Partner Form View Inherit: Subscriptions smart button -->
    <record id="view_partner_form_brightloop" model="ir.ui.view">
        <field name="name">res.partner.form.brightloop</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_subscriptions"
                        icon="fa-refresh">
                    <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Brightloop Customer Tree View -->
    <record id="view_customer_list_brightloop" model="ir.ui.view">
        <field name="name">res.partner.customer.list.brightloop</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Customers">
                <field name="display_name" string="Name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="street" string="Billing Address"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="subscription_count" string="Subscriptions"/>
            </tree>
        </field>
    </record>

    <!-- Customer Action for Brightloop -->
    <record id="action_brightloop_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
        <field name="context">{'default_customer_rank': 1, 'search_default_customer': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new customer for subscription services.
            </p>
        </field>
    </record>
</odoo>
