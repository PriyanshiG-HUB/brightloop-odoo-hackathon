<odoo>
    <record id="view_subscription_plan_list" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="product_id"/><field name="price"/><field name="billing_period"/><field name="active"/></tree></field>
    </record>
    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="product_id"/><field name="price"/><field name="currency_id"/><field name="billing_period"/><field name="minimum_quantity"/><field name="active"/></group><group><field name="start_date"/><field name="end_date"/><field name="auto_close"/><field name="allow_pause"/><field name="allow_early_close"/><field name="allow_renewal"/></group></sheet></form></field>
    </record>
    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field><field name="res_model">subscription.plan</field><field name="view_mode">tree,form</field>
    </record>
</odoo>
