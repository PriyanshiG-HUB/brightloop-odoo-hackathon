<odoo>
    <record id="view_subscription_plan_list" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <tree decoration-muted="availability_status == 'archived'"
                  decoration-danger="availability_status == 'expired'"
                  decoration-warning="availability_status == 'scheduled'"
                  decoration-success="availability_status == 'available'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="price"/>
                <field name="billing_period"/>
                <field name="minimum_quantity"/>
                <field name="availability_status" widget="badge"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="availability_status" widget="statusbar" statusbar_visible="available,scheduled,expired,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="price"/>
                            <field name="currency_id"/>
                            <field name="billing_period"/>
                            <field name="minimum_quantity"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="auto_close"/>
                            <field name="allow_pause"/>
                            <field name="allow_early_close"/>
                            <field name="allow_renewal"/>
                            <field name="allow_cancel"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_plan_search" model="ir.ui.view">
        <field name="name">subscription.plan.search</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="billing_period"/>
                <filter string="Available" name="filter_available" domain="[('availability_status', '=', 'available')]"/>
                <filter string="Daily" name="filter_daily" domain="[('billing_period', '=', 'daily')]"/>
                <filter string="Weekly" name="filter_weekly" domain="[('billing_period', '=', 'weekly')]"/>
                <filter string="Monthly" name="filter_monthly" domain="[('billing_period', '=', 'monthly')]"/>
                <filter string="Yearly" name="filter_yearly" domain="[('billing_period', '=', 'yearly')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Billing Period" name="group_billing_period" context="{'group_by': 'billing_period'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'availability_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_subscription_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription plan.
            </p>
        </field>
    </record>
</odoo>
