
<odoo>
    <!-- Subscription List View -->
    <record id="view_subscription_list" model="ir.ui.view">
        <field name="name">subscription.subscription.list</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'active'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="next_invoice_date"/>
                <field name="amount_total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">subscription.subscription.form</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_quotation"
                            type="object"
                            string="Quotation"
                            invisible="state != 'draft'"
                            class="btn-primary"/>

                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            invisible="state != 'quotation'"
                            class="btn-primary"/>

                    <button name="action_activate"
                            type="object"
                            string="Activate"
                            invisible="state not in ['confirmed', 'paused']"
                            class="btn-primary"/>

                    <button name="action_pause"
                            type="object"
                            string="Pause"
                            invisible="state != 'active'"/>

                    <button name="action_resume"
                            type="object"
                            string="Resume"
                            invisible="state != 'paused'"/>

                    <button name="action_close"
                            type="object"
                            string="Close"
                            invisible="state not in ['active', 'paused']"/>

                    <button name="action_renew"
                            type="object"
                            string="Renew"
                            invisible="state != 'closed'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>

                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="partner_id"/>
                        <field name="plan_id"/>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="next_invoice_date"/>
                        <field name="payment_term_id"/>
                    </group>

                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="subtotal" readonly="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Discounts">
                            <field name="discount_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>

                    <group class="oe_subtotal_footer">
                        <field name="amount_untaxed"/>
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Subscription Action -->
    <record id="action_subscription_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Billing Period List View -->
    <record id="view_billing_period_list" model="ir.ui.view">
        <field name="name">subscription.billing.period.list</field>
        <field name="model">subscription.billing.period</field>
        <field name="arch" type="xml">
            <tree>
                <field name="subscription_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="invoice_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Billing Period Action -->
    <record id="action_subscription_billing_period" model="ir.actions.act_window">
        <field name="name">Billing Periods</field>
        <field name="res_model">subscription.billing.period</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
