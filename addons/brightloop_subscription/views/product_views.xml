<odoo>
    <!-- Product Template Search View -->
    <record id="view_product_template_search_brightloop" model="ir.ui.view">
        <field name="name">product.template.search.brightloop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="brand"/>
            </xpath>
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter string="Has Brand" name="filter_has_brand" domain="[('brand', '!=', False)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Brand" name="group_brand" context="{'group_by': 'brand'}"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Form View Inherit: Brand -->
    <record id="view_product_template_form_brightloop" model="ir.ui.view">
        <field name="name">product.template.form.brightloop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="brand" placeholder="e.g. Brightloop, Acme"/>
            </xpath>
        </field>
    </record>

    <!-- Product Product Form View Inherit: Variant Extra Price -->
    <record id="view_product_variant_form_brightloop" model="ir.ui.view">
        <field name="name">product.product.form.brightloop</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="after">
                <field name="variant_extra_price" widget="monetary"/>
            </xpath>
        </field>
    </record>

    <!-- Product Action for Brightloop -->
    <record id="action_brightloop_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_detailed_type': 'service', 'search_default_filter_to_sell': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a product for Brightloop subscriptions.
            </p>
        </field>
    </record>

    <!-- Product Variant Action for Brightloop -->
    <record id="action_brightloop_product_variants" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
