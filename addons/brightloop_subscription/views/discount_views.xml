<odoo>
    <record id="view_subscription_discount_list" model="ir.ui.view">
        <field name="name">subscription.discount.list</field><field name="model">subscription.discount</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="discount_type"/><field name="discount_value"/><field name="usage_limit"/><field name="used_count"/><field name="active"/></tree></field>
    </record>
    <record id="view_subscription_discount_form" model="ir.ui.view">
        <field name="name">subscription.discount.form</field><field name="model">subscription.discount</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="discount_type"/><field name="discount_value"/><field name="minimum_quantity"/><field name="minimum_amount"/><field name="currency_id"/><field name="product_ids" widget="many2many_tags"/></group><group><field name="start_date"/><field name="end_date"/><field name="usage_limit"/><field name="used_count" readonly="1"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_subscription_discount" model="ir.actions.act_window">
        <field name="name">Discounts</field><field name="res_model">subscription.discount</field><field name="view_mode">tree,form</field>
    </record>
</odoo>
